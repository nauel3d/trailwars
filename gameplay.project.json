{
  "name": "TrailWarsMultiplayerGameplay",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "TrailWars": {
        "$path": "src/shared"
      },
      "TrailWarsUI": {
        "$path": "src/client"
      },
      "TrailWarsDev": {
        "$path": "dev/PolishProof",
        "$className": "Folder"
      }
    },
    "ServerScriptService": {
      "TrailWars": {
        "$className": "Folder",
        "MatchService": {
          "$path": "src/server/MatchService.luau"
        },
        "ProfileStore": {
          "$path": "src/server/ProfileStore.luau"
        },
        "EconomyService": {
          "$path": "src/server/EconomyService.luau"
        },
        "MockStore": {
          "$path": "src/server/MockStore.luau"
        }
      },
      "Gameplay": {
        "$path": "dev/MultiplayerServer.server.luau"
      }
    },
    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "Sensor"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": false,
        "DevTouchMovementMode": "Scriptable",
        "DevComputerMovementMode": "Scriptable"
      },
      "StarterPlayerScripts": {
        "Gameplay": {
          "$path": "dev/MultiplayerBootstrap.client.luau"
        }
      }
    }
  }
}
